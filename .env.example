# Database (Neon DB)
# Pooled connection untuk aplikasi (via PgBouncer) — hostname mengandung "-pooler"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Unpooled/direct connection untuk Drizzle Kit migrasi DDL — tanpa "-pooler"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="86400"

# App
PORT="3001"
NODE_ENV="development"