{
  "name": "automated-inventory",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @repo/shared-types build && pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @repo/backend db:migrate",
    "db:generate": "pnpm --filter @repo/backend db:generate",
    "seed:admin": "pnpm --filter @repo/backend seed:admin"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  }
}
